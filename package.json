{
  "name": "somaya-monorepo",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "watch:packages": "pnpm --filter \"./packages/*\" --parallel watch",
    "dev": "pnpm build:packages && pnpm --filter @somaya/web dev",
    "dev:api": "pnpm build:packages && pnpm --filter @somaya/api start:dev",
    "build": "pnpm build:packages && pnpm --filter @somaya/web build && pnpm --filter @somaya/api build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css}\" \"packages/**/*.ts\" --ignore-path .prettierignore",
    "db:generate": "pnpm --filter @somaya/db db:generate",
    "db:migrate": "pnpm --filter @somaya/db db:migrate",
    "db:studio": "pnpm --filter @somaya/db db:studio"
  },
  "devDependencies": {
    "prettier": "^3.9.8"
  }
}
