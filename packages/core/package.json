{
  "name": "@somaya/core",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./*": { "types": "./dist/*.d.ts", "default": "./dist/*.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@somaya/db": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
